# Copy this file to `.env` and fill in real values. `.env` is gitignored — NEVER commit it.
# Test-mode keys ONLY: https://dashboard.razorpay.com/app/keys

RZP_KEY_ID=rzp_test_xxxxxxxxxxxx
RZP_KEY_SECRET=your_test_secret_here

# Secret used to verify Razorpay webhook signatures (Dashboard → Settings → Webhooks)
RZP_WEBHOOK_SECRET=whsec_test_placeholder

# LLM brain (REQUIRED — PayPilot is LLM-only and refuses to start without it).
# Get a key at https://openrouter.ai/keys ; model list: https://openrouter.ai/models
# The SAME key/model drives every LLM caller: recovery brain (THINK node),
# voice script writer, and two-way dialogue brain. Voice playback itself needs
# no key (browser speechSynthesis; optional server-side .mp3 via `uv sync --extra tts`).
# OPENROUTER_API_KEY also unlocks `paypilot-live-eval` (real LLM brain, measured).
OPENROUTER_API_KEY=
# A free-tier default that emits strict JSON reliably (verified live):
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Reasoning models on free tiers think before answering — give them room (seconds).
OPENROUTER_TIMEOUT_S=90

# App settings
PAYPILOT_ENV=dev
PAYPILOT_LOG_LEVEL=INFO

# Merchant name spoken in voice scripts (optional; default "PayPilot")
MERCHANT_NAME=PayPilot
